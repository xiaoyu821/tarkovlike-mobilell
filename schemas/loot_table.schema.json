{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovlike.local/schemas/loot_table.schema.json",
  "title": "loot_tables.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/lootTable" }
    }
  },
  "$defs": {
    "lootTable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "containerType", "rolls", "entries"],
      "properties": {
        "id": { "type": "string", "pattern": "^loot_[a-z0-9_]{2,59}$" },
        "containerType": { "type": "string", "pattern": "^[a-z][a-z0-9_]{2,31}$" },
        "rolls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["min", "max"],
          "properties": {
            "min": { "type": "integer", "minimum": 1, "maximum": 8 },
            "max": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        "entries": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["itemId", "weight", "qty"],
            "properties": {
              "itemId": { "type": "string", "pattern": "^item_[a-z0-9_]{2,59}$" },
              "weight": { "type": "integer", "minimum": 1, "maximum": 100000 },
              "qty": {
                "type": "object",
                "additionalProperties": false,
                "required": ["min", "max"],
                "properties": {
                  "min": { "type": "integer", "minimum": 1, "maximum": 999 },
                  "max": { "type": "integer", "minimum": 1, "maximum": 999 }
                }
              }
            }
          }
        }
      }
    }
  }
}

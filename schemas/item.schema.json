{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovlike.local/schemas/item.schema.json",
  "title": "items.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/item" }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "nameKey", "displayName", "category",
        "grid", "weightG", "value", "stackMax", "icon", "tags"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^item_[a-z0-9_]{2,59}$" },
        "nameKey": { "type": "string", "pattern": "^l10n\\.[a-z0-9_.]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 40 },
        "category": {
          "enum": ["weapon", "ammo", "armor", "helmet", "med", "loot", "key", "container", "mod"]
        },
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": ["w", "h"],
          "properties": {
            "w": { "type": "integer", "minimum": 1, "maximum": 6 },
            "h": { "type": "integer", "minimum": 1, "maximum": 6 }
          }
        },
        "weightG": { "type": "integer", "minimum": 0, "maximum": 200000 },
        "value": { "type": "integer", "minimum": 0, "maximum": 10000000 },
        "stackMax": { "type": "integer", "minimum": 1, "maximum": 999 },
        "icon": { "type": "string", "pattern": "^icons/[a-z0-9_/]+\\.png$" },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[a-z0-9_]{2,24}$" }
        }
      }
    }
  }
}

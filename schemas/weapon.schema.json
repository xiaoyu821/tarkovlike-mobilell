{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovlike.local/schemas/weapon.schema.json",
  "title": "weapons.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/weapon" }
    }
  },
  "$defs": {
    "weapon": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "itemId", "caliber", "baseDamage", "damageMultiplier",
        "rpm", "magazineCapacity", "recoilCurve", "attachmentSlots", "allowedAmmo"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^wpn_[a-z0-9_]{2,59}$" },
        "itemId": { "type": "string", "pattern": "^item_[a-z0-9_]{2,59}$" },
        "caliber": { "type": "string", "pattern": "^[0-9][0-9a-z.x]{1,11}$" },
        "baseDamage": { "type": "integer", "minimum": 1, "maximum": 500 },
        "damageMultiplier": { "type": "number", "minimum": 0.5, "maximum": 1.5 },
        "rpm": { "type": "integer", "minimum": 30, "maximum": 1200 },
        "magazineCapacity": { "type": "integer", "minimum": 2, "maximum": 100 },
        "recoilCurve": {
          "type": "object",
          "additionalProperties": false,
          "required": ["vertical", "horizontal"],
          "properties": {
            "vertical": {
              "type": "array", "minItems": 1, "maxItems": 60,
              "items": { "type": "number", "minimum": 0, "maximum": 20 }
            },
            "horizontal": {
              "type": "array", "minItems": 1, "maxItems": 60,
              "items": { "type": "number", "minimum": 0, "maximum": 20 }
            }
          }
        },
        "attachmentSlots": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["optic", "muzzle", "grip", "magazine", "stock", "laser"] }
        },
        "allowedAmmo": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^ammo_[a-z0-9_]{2,59}$" }
        }
      }
    }
  }
}

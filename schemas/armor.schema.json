{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovlike.local/schemas/armor.schema.json",
  "title": "armor.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/armor" }
    }
  },
  "$defs": {
    "armor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "itemId", "protectionLevel", "durability", "coverage"],
      "properties": {
        "id": { "type": "string", "pattern": "^armor_[a-z0-9_]{2,59}$" },
        "itemId": { "type": "string", "pattern": "^item_[a-z0-9_]{2,59}$" },
        "protectionLevel": { "type": "integer", "minimum": 1, "maximum": 6 },
        "durability": { "type": "integer", "minimum": 1, "maximum": 1000 },
        "coverage": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["head", "chest", "limbs"] }
        }
      }
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tarkovlike.local/schemas/ammo.schema.json",
  "title": "ammo.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/ammo" }
    }
  },
  "$defs": {
    "ammo": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "itemId", "caliber", "damage", "penetration", "muzzleVelocity", "pellets"],
      "properties": {
        "id": { "type": "string", "pattern": "^ammo_[a-z0-9_]{2,59}$" },
        "itemId": { "type": "string", "pattern": "^item_[a-z0-9_]{2,59}$" },
        "caliber": { "type": "string", "pattern": "^[0-9][0-9a-z.x]{1,11}$" },
        "damage": { "type": "integer", "minimum": 1, "maximum": 300 },
        "penetration": { "type": "integer", "minimum": 0, "maximum": 80 },
        "muzzleVelocity": { "type": "integer", "minimum": 150, "maximum": 1500 },
        "pellets": { "type": "integer", "minimum": 1, "maximum": 16 }
      }
    }
  }
}
